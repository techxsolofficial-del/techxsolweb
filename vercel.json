{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/blogs/:slug*",
      "destination": "/blog.html"
    },
    {
      "source": "/blog/:slug*",
      "destination": "/blog.html"
    },
    {
      "source": "/blogs",
      "destination": "/blog.html"
    },
    {
      "source": "/tools/:slug*",
      "destination": "/tools.html"
    },
    {
      "source": "/tools",
      "destination": "/tools.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ]
}
