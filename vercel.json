{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/blogs/:slug*",
      "destination": "/blog.html"
    },
    {
      "source": "/blog/:slug*",
      "destination": "/blog.html"
    },
    {
      "source": "/blogs",
      "destination": "/blog.html"
    },
    {
      "source": "/tools/html-designer",
      "destination": "/html-designer.html"
    },
    {
      "source": "/tools/html-page-designer",
      "destination": "/html-designer.html"
    },
    {
      "source": "/designer",
      "destination": "/html-designer.html"
    },
    {
      "source": "/tools/:slug*",
      "destination": "/tools.html"
    },
    {
      "source": "/tools",
      "destination": "/tools.html"
    },
    {
      "source": "/leadership",
      "destination": "/leadership.html"
    },
    {
      "source": "/team",
      "destination": "/leadership.html"
    },
    {
      "source": "/founders",
      "destination": "/leadership.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ]
}
